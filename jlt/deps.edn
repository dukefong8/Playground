{:paths ["src"]

 :jolt/min-version "0.8.6"

 ;; fulcro-spec's :bb branches avoid JVM-only ClojureScript test machinery.
 :jolt/features [:bb]

 ;; Guardrails and Truss are declared statically so this project can be run
 ;; directly with Jolt's normal deps.edn resolution.
 :deps {org.clojure/spec.alpha
        {:mvn/version "0.5.238"}

        org.clojure/core.specs.alpha
        {:mvn/version "0.4.74"}

        org.clojure/test.check
        {:mvn/version "1.1.3"}

        com.fulcrologic/guardrails
        {:mvn/version "1.3.3"}

        com.taoensso/truss
        {:mvn/version "2.5.1"}

        metosin/malli
        {:mvn/version "0.20.1"}

        io.github.jolt-lang/time
        {:git/url "https://github.com/jolt-lang/time.git"
         :git/tag "v0.0.9"
         :git/sha "abeee49974c2c4efa2fa75c96d9a379822c6815f"}}

 :aliases {:test {:extra-paths ["test"]
                  :extra-deps {fulcrologic/fulcro-spec
                               {:mvn/version "3.2.9"
                                ;; fulcro-spec is test-only and otherwise brings
                                ;; an older Guardrails and Malli copy.
                                :exclusions [com.fulcrologic/guardrails metosin/malli]}}
                  :main-opts ["-m" "jolt.guardrails.test-runner"]}}

 :tasks {test "GUARDRAILS_ENABLED=true jolt -M:test"}}
