{:paths ["src"]

 :jolt/min-version "0.8.6"

 ;; fulcro-spec's :bb branches avoid JVM-only ClojureScript test machinery.
 :jolt/features [:bb]

 ;; superv.async needs core.async's impl.protocols and alt!, neither of which
 ;; Jolt ships. Claiming the namespace lets src/clojure/core/async.jolt win over
 ;; Jolt's own copy, so that file can load the overlay Jolt already carries and
 ;; then load the one shim — which is what lets a bare
 ;; (require 'clojure.core.async) install everything. See that file for why it
 ;; delegates rather than replaces.
 :jolt/replaces [clojure.core.async]

 ;; Guardrails and Truss are declared statically so this project can be run
 ;; directly with Jolt's normal deps.edn resolution.
 :deps {babashka/babashka.pods
        {:mvn/version "0.2.0"
         :exclusions [cheshire/cheshire]}

        org.clojure/data.json
        {:mvn/version "2.5.0"}

        jolt-lang/transit-jolt
        {:git/url "https://github.com/jolt-lang/transit-jolt"
         :git/tag "v0.1.0"
         :git/sha "909255b3bbdc04bbd1c7782b4056f8d2f082ec8d"}

        org.clojure/spec.alpha
        {:mvn/version "0.5.238"}

        org.clojure/core.specs.alpha
        {:mvn/version "0.4.74"}

        org.clojure/test.check
        {:mvn/version "1.1.3"}

        com.fulcrologic/guardrails
        {:mvn/version "1.3.3"}

        com.taoensso/truss
        {:mvn/version "2.5.1"}

        com.taoensso/tufte
        {:mvn/version "3.1.0"}

        metosin/malli
        {:mvn/version "0.20.1"}

        io.github.jolt-lang/time
        {:git/url "https://github.com/jolt-lang/time.git"
         :git/tag "v0.0.9"
         :git/sha "abeee49974c2c4efa2fa75c96d9a379822c6815f"}

        ;; Developed alongside this project, so a live :local/root rather than a
        ;; pinned git dep. Jolt drops the clojure/clojurescript coordinates it
        ;; declares, leaving core.async to resolve normally.
        superv.async/superv.async
        {:local/root "../../superv.async"}}

 :aliases {;; superv.async's own suite rides along on the test path, so one run
           ;; covers it — see jolt.test-runner for the shim ordering it needs.
           :test {:extra-paths ["test" "../../superv.async/test"]
                  :extra-deps {fulcrologic/fulcro-spec
                               {:mvn/version "3.2.9"
                                ;; fulcro-spec is test-only and otherwise brings
                                ;; an older Guardrails and Malli copy.
                                :exclusions [com.fulcrologic/guardrails metosin/malli]}}
                  :main-opts ["-m" "jolt.test-runner"]}}

 ;; Guardrails instrumentation depends on properties at macro-expansion time.
 ;; Cached namespaces can retain checks compiled with a different configuration.
 :tasks {test "JOLT_AOT_CACHE=0 GUARDRAILS_ENABLED=true ./jolt -M:test"}}
